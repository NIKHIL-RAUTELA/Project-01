{
  "rewrites": [
    {
      "source": "/api/dashboard",
      "destination": "/api/index/dashboard"
    },
    {
      "source": "/api/workers",
      "destination": "/api/index/workers"
    },
    {
      "source": "/api/attendance",
      "destination": "/api/index/attendance"
    },
    {
      "source": "/api/workers/:workerId",
      "destination": "/api/index/workers/:workerId"
    }
  ]
}
