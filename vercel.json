{
  "rewrites": [
    {
      "source": "/api/dashboard",
      "destination": "/api/index?route=dashboard"
    },
    {
      "source": "/api/workers",
      "destination": "/api/index?route=workers"
    },
    {
      "source": "/api/attendance",
      "destination": "/api/index?route=attendance"
    },
    {
      "source": "/api/workers/:workerId",
      "destination": "/api/index?route=workers/:workerId"
    }
  ]
}
