{
  "rewrites": [
    {
      "source": "/api/dashboard",
      "destination": "/api/index?path=dashboard"
    },
    {
      "source": "/api/workers",
      "destination": "/api/index?path=workers"
    },
    {
      "source": "/api/attendance",
      "destination": "/api/index?path=attendance"
    },
    {
      "source": "/api/workers/:workerId",
      "destination": "/api/index?path=workers/:workerId"
    }
  ]
}
